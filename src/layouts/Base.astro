---
import SiteLink from '../components/SiteLink.astro';
import '../styles/site.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/sakib-mahmud.jpg';
import { navigation, profile, sitePath } from '../lib/site';

const { title, description = profile.focus + ' ' + profile.bio, shareImage = portrait, noIndex = false } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Biomedical AI Research`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = await getImage({ src: shareImage, width: Math.min(shareImage.width, 750), format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: canonical.href,
    jobTitle: profile.role,
    image: shareUrl,
    affiliation: { '@type': 'CollegeOrUniversity', name: profile.affiliation },
    sameAs: [profile.orcid, profile.scholar, profile.github],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f9f9f6" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={shareUrl} />
    <meta name="twitter:card" content="summary" />
    {Astro.url.pathname === sitePath() && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {noIndex ? <meta name="robots" content="noindex,follow" /> : <link rel="canonical" href={canonical.href} />}
    <link rel="icon" type="image/png" href={sitePath('favicon.png')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a target="_self" class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell masthead">
        <SiteLink class="brand" href={sitePath()}>{profile.name}</SiteLink>
        <nav aria-label="Main navigation">
          {navigation.map(({ label, path }) => {
            const href = sitePath(path);
            const current = Astro.url.pathname === href ? 'page' : Astro.url.pathname.startsWith(href) ? 'location' : undefined;
            return <SiteLink href={href} aria-current={current}>{label}</SiteLink>;
          })}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-content">
        <div>
          <p class="footer-name">{profile.name}</p>
          <p>{profile.role}, {profile.affiliation}</p>
        </div>
        <nav aria-label="Professional links">
          <SiteLink href={`mailto:${profile.email}`}>Email</SiteLink>
          <SiteLink href={profile.github}>GitHub</SiteLink>
          <SiteLink href={profile.scholar}>Google Scholar</SiteLink>
          <SiteLink href={profile.orcid}>ORCID</SiteLink>
        </nav>
      </div>
    </footer>
  </body>
</html>
