---
import SiteLink from '../components/SiteLink.astro';
import '../styles/theme.css';
import '../styles/site.css';
import { getImage } from 'astro:assets';
import portrait from '../assets/sakib-mahmud.jpg';
import { navigation, profile, researchProfiles, sitePath } from '../lib/site';
import { colorModeKey, themeBackgrounds, themeCss } from '../lib/themes';

const { title, description = profile.bio, shareImage = portrait, largeShareImage = false, noIndex = false } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Biomedical AI Research`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const share = await getImage({ src: shareImage, width: Math.min(shareImage.width, largeShareImage ? 1200 : 750), format: 'jpg' });
const shareUrl = new URL(share.src, Astro.site).href;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  mainEntity: {
    '@type': 'Person',
    name: profile.name,
    url: canonical.href,
    jobTitle: profile.role,
    image: shareUrl,
    email: `mailto:${profile.email}`,
    affiliation: { '@type': 'CollegeOrUniversity', name: profile.affiliation },
    worksFor: { '@type': 'CollegeOrUniversity', name: profile.affiliation, department: { '@type': 'Organization', name: profile.department } },
    alumniOf: { '@type': 'CollegeOrUniversity', name: profile.affiliation },
    knowsAbout: ['Biomedical machine learning', 'Wearable biomechanics', 'Medical image segmentation', 'Physiological signal processing', 'Raman spectroscopy'],
    sameAs: [...researchProfiles.map(({ href }) => href), profile.github, profile.linkedin],
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content={themeBackgrounds.light} />
    <script define:vars={{ colorModeKey, themeBackgrounds }}>
      // Lets CSS reserve the theme button's place before the page paints, so the header never shifts.
      document.documentElement.classList.add('has-js');
      try {
        if (localStorage.getItem(colorModeKey) === 'dark') {
          document.documentElement.dataset.colorMode = 'dark';
          document.querySelector('meta[name="theme-color"]').content = themeBackgrounds.dark;
        }
      } catch {
        // The default theme is available when storage is disabled.
      }
    </script>
    <style is:inline set:html={themeCss}></style>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!noIndex && <meta property="og:url" content={canonical.href} />}
    <meta property="og:image" content={shareUrl} />
    {largeShareImage && <>
      <meta property="og:image:width" content={share.attributes.width} />
      <meta property="og:image:height" content={share.attributes.height} />
      <meta property="og:image:alt" content={`${title} · Sakib Mahmud`} />
    </>}
    <meta name="twitter:card" content={largeShareImage ? 'summary_large_image' : 'summary'} />
    {Astro.url.pathname === sitePath() && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    {noIndex ? <meta name="robots" content="noindex,follow" /> : <link rel="canonical" href={canonical.href} />}
    <link rel="icon" type="image/png" sizes="32x32" href={sitePath('favicon.png?v=2')} />
    <link rel="icon" type="image/svg+xml" sizes="any" href={sitePath('favicon.svg')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a target="_self" class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell masthead">
        <SiteLink class="brand" href={sitePath()}>{profile.name}</SiteLink>
        <nav aria-label="Main navigation">
          {navigation.map(({ label, path }) => {
            const href = sitePath(path);
            const current = Astro.url.pathname === href ? 'page' : Astro.url.pathname.startsWith(href) ? 'location' : undefined;
            return <SiteLink href={href} aria-current={current}>{label}</SiteLink>;
          })}
        </nav>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Dark mode" aria-pressed="false">
          <svg class="theme-moon" aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
            <path d="M20.9 13.3a9 9 0 0 1-10.2-10.2 9 9 0 1 0 10.2 10.2Z" />
          </svg>
          <svg class="theme-sun" aria-hidden="true" width="21" height="21" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round">
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4m0-14.2-1.4 1.4M6.3 17.7l-1.4 1.4" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <span id="new-tab-note" hidden>Opens in a new tab</span>
    <footer class="site-footer">
      <div class="shell footer-content">
        <div>
          <p class="footer-name">{profile.name}</p>
          <p>{profile.role}, {profile.affiliation}</p>
        </div>
        <nav aria-label="Professional links">
          <SiteLink href={`mailto:${profile.email}`}>Email</SiteLink>
          <SiteLink href={profile.github}>GitHub</SiteLink>
          <SiteLink href={profile.scholar}>Google Scholar</SiteLink>
          <SiteLink href={profile.orcid}>ORCID</SiteLink>
          <SiteLink href={profile.linkedin}>LinkedIn</SiteLink>
        </nav>
      </div>
    </footer>
  </body>
</html>

<script>
  import '../scripts/theme-toggle';

  const header = document.querySelector<HTMLElement>('.site-header');
  if (header) {
    const updateHeaderOffset = () => {
      const offset = Math.ceil(header.getBoundingClientRect().height) + 10;
      document.documentElement.style.setProperty('--header-offset', `${offset}px`);
    };
    updateHeaderOffset();
    new ResizeObserver(updateHeaderOffset).observe(header);
  }
</script>
