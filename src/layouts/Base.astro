---
import '../styles/site.css';
import { navigation, profile, sitePath } from '../lib/site';

const { title, description = profile.focus } = Astro.props;
const pageTitle = title ? `${title} | ${profile.name}` : `${profile.name} | Biomedical AI Research`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f6f1" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" type="image/png" href={sitePath('favicon.png')} />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="shell masthead">
        <a class="brand" href={sitePath()}>{profile.name}</a>
        <nav aria-label="Main navigation">
          {navigation.map(({ label, path }) => {
            const href = sitePath(path);
            return <a href={href} aria-current={Astro.url.pathname.startsWith(href) ? 'page' : undefined}>{label}</a>;
          })}
        </nav>
      </div>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-content">
        <div>
          <p class="footer-name">{profile.name}</p>
          <p>{profile.role}, {profile.affiliation}</p>
        </div>
        <nav aria-label="Professional links">
          <a href={`mailto:${profile.email}`}>Email</a>
          <a href={profile.github}>GitHub</a>
          <a href={profile.scholar}>Google Scholar</a>
          <a href={profile.orcid}>ORCID</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
