---
import SiteLink from './SiteLink.astro';
import { Image } from 'astro:assets';
import type { ResearchFigure } from '../data/research';

type Props = {
  figure: Omit<ResearchFigure, 'credit'> & { credit?: ResearchFigure['credit'] };
  class?: string;
  /** Load immediately, for the display figure near the top of the page. */
  eager?: boolean;
};

const { figure, class: className, eager = false } = Astro.props;
const { credit, licence } = figure;
// Dense paper figures need high-density sources to stay legible on retina screens.
const width = Math.min(figure.image.width, 1400);
const widths = [320, 480, 640, 768, 960, 1200].filter(candidate => candidate < width).concat(width);
---

<figure class:list={['detail-figure', className]} data-figure>
  <div>
    <Image src={figure.image} alt={figure.alt} width={width} widths={widths} sizes="(max-width: 850px) calc(100vw - 4rem), 730px" format="webp" loading={eager ? 'eager' : 'lazy'} />
  </div>
  <figcaption>
    {figure.caption}
    <span class="figure-links">
      <SiteLink href={figure.image.src}>View full-size figure</SiteLink>
      {credit && (credit.href
        ? <SiteLink href={credit.href} data-figure-credit>{credit.label}</SiteLink>
        : <span data-figure-credit>{credit.label}</span>)}
      {licence && (licence.href
        ? <SiteLink href={licence.href}>{licence.label}</SiteLink>
        : <span>{licence.label}</span>)}
    </span>
  </figcaption>
</figure>
