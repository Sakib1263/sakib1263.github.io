---
import SiteLink from '../components/SiteLink.astro';
import { currentResearch } from '../data/research-projects';
import { sitePath } from '../lib/site';
---

<section class="current-research" aria-labelledby="current-title">
  <div class="section-heading">
    <h2 id="current-title">Ongoing research</h2>
  </div>
  <div class="resource-list">
    {currentResearch.map(({ area, title, summary, href }) => (
      <article>
        <p class="overline">{area}</p>
        <h3><SiteLink href={sitePath(href)}>{title}</SiteLink></h3>
        <p>{summary}</p>
      </article>
    ))}
  </div>
</section>
