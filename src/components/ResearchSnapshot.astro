---
import SiteLink from './SiteLink.astro';
import snapshot from '../data/google-scholar.json';
import { profile, researchProfiles } from '../lib/site';
import '../styles/research-snapshot.css';

const otherProfiles = researchProfiles.filter(({ label }) => ['Scopus', 'Web of Science', 'ORCID'].includes(label));
const number = new Intl.NumberFormat('en-GB');
const date = new Intl.DateTimeFormat('en-GB', { dateStyle: 'medium', timeZone: 'UTC' });
const metrics = [
  { key: 'citations', label: 'Citations' },
  { key: 'hIndex', label: 'h-index' },
  { key: 'i10Index', label: 'i10-index' },
] as const;
const maximum = Math.max(1, ...snapshot.yearly.map(entry => entry.citations));
// Scholar counts the current year to date, so its bar is drawn differently and named in the note.
const partialYear = snapshot.checkedOn.endsWith('-12-31') ? undefined : Number(snapshot.checkedOn.slice(0, 4));
const hasPartialYear = snapshot.yearly.some(({ year }) => year === partialYear);
---

<section class="research-snapshot" aria-labelledby="research-profile">
  <header class="catalog-section-heading snapshot-heading">
    <div>
      <h2 id="research-profile">Research profile</h2>
      <p>Google Scholar citation metrics</p>
    </div>
    <SiteLink href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></SiteLink>
  </header>

  <div class="citation-snapshot">
    <div>
      <dl class="citation-metrics" aria-label="Google Scholar all-time metrics">
        {metrics.map(({ key, label }) => (
          <div>
            <dt>{label}</dt>
            <dd>
              <strong data-count-to={snapshot.totals[key]}>{number.format(snapshot.totals[key])}</strong>
              <small>{number.format(snapshot.recent[key])} since {snapshot.recent.since}</small>
            </dd>
          </div>
        ))}
      </dl>
      <p class="snapshot-date">Checked on <time datetime={snapshot.checkedOn}>{date.format(new Date(snapshot.checkedOn))}</time></p>
    </div>

    <figure class="citation-history" aria-label="Google Scholar yearly citation counts">
      <figcaption>Yearly citations</figcaption>
      <ol class="citation-bars" role="list" style={`--citation-years:${snapshot.yearly.length}`}>
        {snapshot.yearly.map(({ year, citations }, index) => (
          <li data-partial-year={year === partialYear ? '' : undefined} style={`--bar-index:${index}`}>
            <span class="citation-year">{year}</span>
            <span class="citation-column">
              <span class="citation-count">{number.format(citations)}<span class="citation-unit"> citations</span></span>
              <span class="citation-bar" style={`--citation-height:${citations / maximum * 100}%`} aria-hidden="true"></span>
            </span>
          </li>
        ))}
      </ol>
      <p class="citation-history-note">Counts through the date shown.{hasPartialYear && ` The striped ${partialYear} bar covers part of the year.`}</p>
    </figure>
  </div>

  <div class="snapshot-profiles">
    <nav aria-label="Other research profiles">
      {otherProfiles.map(({ href, label }) => <SiteLink href={href}>{label} <span aria-hidden="true">↗</span></SiteLink>)}
    </nav>
  </div>
</section>

<script is:inline>
  // Runs before first paint: the chart starts empty only when motion is allowed, and animates once in view.
  (() => {
    const section = document.currentScript?.previousElementSibling;
    if (!section || !('IntersectionObserver' in window) || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    section.setAttribute('data-animate', '');
    const format = new Intl.NumberFormat('en-GB');
    const countUp = element => {
      const target = Number(element.dataset.countTo);
      const start = performance.now();
      const step = now => {
        const progress = Math.min((now - start) / 1100, 1);
        element.textContent = format.format(Math.round(target * (1 - (1 - progress) ** 3)));
        if (progress < 1) requestAnimationFrame(step);
      };
      element.textContent = '0';
      requestAnimationFrame(step);
    };
    const observer = new IntersectionObserver(entries => {
      if (!entries.some(entry => entry.isIntersecting)) return;
      observer.disconnect();
      section.setAttribute('data-animate', 'in-view');
      section.querySelectorAll('[data-count-to]').forEach(countUp);
    }, { threshold: 0.35 });
    observer.observe(section);
  })();
</script>
