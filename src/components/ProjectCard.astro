---
import SiteLink from '../components/SiteLink.astro';
import { Image } from 'astro:assets';
import type { Project } from '../data/research';
import { publicationFor } from '../data/papers';
import { sitePath } from '../lib/site';

const { project } = Astro.props as { project: Project };
const { visual } = project;
const paper = publicationFor(project.doi);
const imageWidth = visual ? Math.min(visual.image.width, 384) : 0;
---

<article class="project-card">
  {visual && (
    <div class:list={['project-art', `art-${project.slug}`]}>
      <Image src={visual.image} alt={visual.alt} width={imageWidth} widths={[96, 192, 288].filter(width => width < imageWidth).concat(imageWidth)} sizes="(max-width: 480px) 72px, (max-width: 720px) 112px, 176px" format="webp" />
    </div>
  )}
  {project.illustratedExample && (
    <div class="project-art art-prenatal-hydronephrosis" aria-hidden="true">
      <div class="ahn-example-views ahn-example-masks"><span></span><span></span><span></span></div>
      <span class="ahn-card-arrow">→</span>
      <span class="ahn-example-grade">II</span>
    </div>
  )}
  <div class="project-card-body">
    <p class="overline">{project.area} · {paper.year}</p>
    <h3><SiteLink href={sitePath(`research/${project.slug}/`)}>{project.title}</SiteLink></h3>
    <p>{project.summary}</p>
  </div>
</article>
