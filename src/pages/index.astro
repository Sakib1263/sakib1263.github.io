---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import portrait from '../assets/sakib-mahmud.jpg';
import { featuredProjects } from '../data/research';
import { profile, sitePath } from '../lib/site';
---

<Base>
  <section class="shell intro" aria-labelledby="intro-title">
    <div class="intro-copy">
      <p class="overline intro-role"><span aria-hidden="true"></span>{profile.role} · {profile.affiliation}</p>
      <h1 id="intro-title">{profile.name}</h1>
      <p class="intro-lead">{profile.focus}</p>
      <p class="intro-detail">My research includes kidney segmentation in CT, estimation of foot kinetics from smart insoles, and standardization of Raman spectra across instruments.</p>
      <div class="intro-actions">
        <a class="button button-primary" href={sitePath('research/')}>Explore research <span aria-hidden="true">↗</span></a>
        <a class="button button-secondary" href={sitePath('publications/')}>Publications</a>
      </div>
      <div class="profile-links">
        <a href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></a>
        <a href={profile.orcid}>ORCID <span aria-hidden="true">↗</span></a>
        <a href={profile.github}>GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <figure class="portrait">
      <Image src={portrait} alt="Sakib Mahmud" widths={[384, 576, 768]} sizes="(max-width: 740px) 83vw, 340px" width={768} format="webp" loading="eager" fetchpriority="high" />
      <figcaption><span aria-hidden="true"></span>{profile.location}</figcaption>
    </figure>
  </section>

  <section class="selected-section" aria-labelledby="selected-title">
    <div class="shell">
      <div class="section-heading">
        <h2 id="selected-title">Selected research</h2>
        <a class="text-link" href={sitePath('research/')}>All research <span aria-hidden="true">↗</span></a>
      </div>
      <div class="project-grid">
        {featuredProjects.map(project => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <section class="shell connection" aria-labelledby="contact-title">
    <div>
      <h2 id="contact-title">Contact</h2>
      <p>For questions about the research or software, contact me at Qatar University.</p>
    </div>
    <a class="text-link" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
  </section>
</Base>
