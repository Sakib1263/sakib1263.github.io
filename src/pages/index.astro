---
import SiteLink from '../components/SiteLink.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CurrentResearch from '../components/CurrentResearch.astro';
import portrait from '../assets/sakib-mahmud.jpg';
import { publicationId, selectedPapers } from '../data/papers';
import { featuredProjects } from '../data/research';
import { cvPdfPath, profile, sitePath } from '../lib/site';
import '../styles/home.css';

const homePaperDois = new Set([
  '10.1016/j.talanta.2026.130241',
  '10.1016/j.bspc.2026.109894',
  '10.1016/j.compbiomed.2021.105002',
]);
const homePapers = selectedPapers.filter(({ publication }) => homePaperDois.has(publication.doi));
---

<Base>
  <section class="home-hero" aria-labelledby="intro-title">
    <div class="shell home-hero-layout">
      <div class="home-intro">
        <h1 id="intro-title">{profile.name}</h1>
        <p class="home-role">{profile.role} · {profile.affiliation}</p>
        <p class="home-department">{profile.department} · {profile.location}</p>
        <p class="home-focus">{profile.focus}</p>
        <p class="home-bio">{profile.bio}</p>
        <p class="home-credentials"><SiteLink href={sitePath('cv/#education-title')}>MSc and BSc (Hons.) in Electrical Engineering</SiteLink> · {profile.affiliation}</p>
        <div class="actions home-hero-actions">
          <SiteLink class="button button-primary" href="#current-research">Explore research <span aria-hidden="true">↓</span></SiteLink>
          <SiteLink class="button button-secondary" href={sitePath(cvPdfPath)} download>Download CV <span aria-hidden="true">↓</span></SiteLink>
          <SiteLink class="text-link home-contact-jump" href="#contact">Contact <span aria-hidden="true">↓</span></SiteLink>
        </div>
      </div>
      <figure class="home-portrait">
        <Image
          src={portrait}
          alt="Portrait of Sakib Mahmud"
          widths={[320, 480, 640, portrait.width]}
          sizes="(max-width: 320px) calc(100vw - 2rem), (max-width: 620px) 288px, (max-width: 815px) 256px, (max-width: 1024px) calc(34vw - 16px), 304px"
          width={portrait.width}
          format="webp"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    </div>
  </section>

  <section class="shell home-section" id="current-research" aria-labelledby="selected-title">
    <div class="section-heading">
      <h2 id="selected-title">Featured research</h2>
      <div class="featured-research-links">
        <SiteLink class="text-link" href={sitePath('research/summary/')}>Research summary <span aria-hidden="true">→</span></SiteLink>
        <SiteLink class="text-link" href={sitePath('research/')}>All research <span aria-hidden="true">→</span></SiteLink>
      </div>
    </div>
    <div class="project-list">
      {featuredProjects.map(project => <ProjectCard project={project} />)}
    </div>
  </section>

  <div class="shell home-section home-notes">
    <CurrentResearch />
    <section class="selected-papers" aria-labelledby="papers-title">
      <div class="section-heading">
        <h2 id="papers-title">Selected publications</h2>
        <SiteLink class="text-link" href={sitePath('publications/?view=selected#bibliography')}>More selected papers <span aria-hidden="true">→</span></SiteLink>
      </div>
      <div class="resource-list">
        {homePapers.map(({ publication, context }) => (
          <article class="paper-preview">
            <p class="overline">{publication.venue} · {publication.onlineYear ? `${publication.year} issue · Online ${publication.onlineYear}` : publication.year}</p>
            <h3><SiteLink href={sitePath(`publications/#${publicationId(publication.doi)}`)}>{publication.title}</SiteLink></h3>
            <p>{context}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="shell home-section" id="contact" aria-labelledby="contact-title">
    <div class="home-contact">
      <div>
        <h2 id="contact-title">Contact</h2>
        <p class="home-contact-message">I welcome enquiries about PhD opportunities and collaborations in medical imaging, wearable biomechanics, and biomedical sensing.</p>
        <p class="home-affiliation">{profile.department} · {profile.affiliation} · {profile.location}</p>
      </div>
      <div class="home-contact-links">
        <SiteLink class="home-email" href={`mailto:${profile.email}?subject=Research%20inquiry`}>{profile.email}</SiteLink>
        <nav aria-label="Professional and research profiles">
          <SiteLink href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></SiteLink>
          <SiteLink href={profile.linkedin}>LinkedIn <span aria-hidden="true">↗</span></SiteLink>
          <SiteLink href={profile.researchGate}>ResearchGate <span aria-hidden="true">↗</span></SiteLink>
          <SiteLink href={profile.orcid}>ORCID <span aria-hidden="true">↗</span></SiteLink>
          <SiteLink href={profile.github}>GitHub <span aria-hidden="true">↗</span></SiteLink>
        </nav>
      </div>
    </div>
  </section>
</Base>
