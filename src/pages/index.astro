---
import SiteLink from '../components/SiteLink.astro';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CurrentResearch from '../components/CurrentResearch.astro';
import portrait from '../assets/sakib-mahmud.jpg';
import { publicationId, selectedPapers } from '../data/papers';
import { featuredProjects } from '../data/research';
import { cvPdfPath, profile, sitePath } from '../lib/site';

const portraitWidth = Math.min(portrait.width, 416);
const portraitWidths = [128, 256].filter(width => width < portraitWidth).concat(portraitWidth);
---

<Base>
  <section class="shell intro" aria-labelledby="intro-title">
    <div class="intro-identity">
      <h1 id="intro-title">{profile.name}</h1>
      <p class="intro-role">{profile.role} · {profile.affiliation}</p>
      <p class="intro-location">{profile.department} · {profile.location}</p>
    </div>
    <div class="portrait">
      <Image src={portrait} alt="Portrait of Sakib Mahmud" widths={portraitWidths} sizes="(max-width: 720px) 112px, 208px" width={portraitWidth} format="webp" loading="eager" fetchpriority="high" />
    </div>
    <div class="intro-copy">
      <p class="intro-lead">{profile.focus}</p>
      <p class="intro-detail">{profile.bio}</p>
      <div class="intro-actions">
        <SiteLink class="button button-primary" href="#current-research">Explore research <span aria-hidden="true">↓</span></SiteLink>
        <SiteLink class="button button-secondary" href={sitePath(cvPdfPath)} download>Download CV <span aria-hidden="true">↓</span></SiteLink>
      </div>
      <div class="profile-links">
        <SiteLink href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></SiteLink>
        <SiteLink href={profile.orcid}>ORCID <span aria-hidden="true">↗</span></SiteLink>
        <SiteLink href={profile.github}>GitHub <span aria-hidden="true">↗</span></SiteLink>
      </div>
    </div>
  </section>

  <section class="selected-section" aria-labelledby="selected-title">
    <div class="shell">
      <div class="section-heading">
        <h2 id="selected-title">Featured projects</h2>
        <SiteLink class="text-link" href={sitePath('research/')}>All research <span aria-hidden="true">→</span></SiteLink>
      </div>
      <div class="project-list">
        {featuredProjects.map(project => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>

  <div class="shell home-notes">
    <CurrentResearch />
    <section class="selected-papers" aria-labelledby="papers-title">
      <div class="section-heading">
        <h2 id="papers-title">Selected papers</h2>
        <SiteLink class="text-link" href={sitePath('publications/?view=selected#bibliography')}>All selected papers <span aria-hidden="true">→</span></SiteLink>
      </div>
      <div class="resource-list">
        {selectedPapers.slice(0, 3).map(({ publication, context }) => (
          <article class="paper-preview">
            <p class="overline">{publication.venue} · {publication.onlineYear ? `Online ${publication.onlineYear}` : publication.year}</p>
            <h3><SiteLink href={sitePath(`publications/#${publicationId(publication.doi)}`)}>{publication.title}</SiteLink></h3>
            <p>{context}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <section class="shell connection" id="contact" aria-labelledby="contact-title">
    <div>
      <h2 id="contact-title">Contact</h2>
      <p>I welcome conversations about PhD research and collaborations on evaluating biomedical models across cohorts, clinical sites, and instruments.</p>
    </div>
    <SiteLink class="text-link" href={`mailto:${profile.email}?subject=Research%20inquiry`}>{profile.email} <span aria-hidden="true">↗</span></SiteLink>
  </section>
</Base>
