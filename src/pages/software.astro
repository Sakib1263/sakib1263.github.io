---
import SiteLink from '../components/SiteLink.astro';
import Base from '../layouts/Base.astro';
import { datasets } from '../data/datasets';
import { kinetics } from '../data/kinetics';
import { ramanSource } from '../data/raman';
import { publicationFor, publicationId } from '../data/papers';
import { projects } from '../data/research';
import { doiUrl, profile, sitePath } from '../lib/site';
import '../styles/catalog.css';
import '../styles/software.css';

type Link = { label: string; href: string };
const softwareNotes: Partial<Record<string, { label: string; detail: string; version: Link; guide?: Link }>> = {
  'superonn-layers': {
    label: 'Versioned library',
    detail: 'The release provides the library and its examples. Setup depends on whether you use the PyTorch or TensorFlow backend.',
    version: { label: 'Release v0.5.1', href: 'https://github.com/Sakib1263/SuperONN-Layers/releases/tag/v0.5.1' },
  },
  'wearable-foot-kinetics': {
    label: 'Versioned code and verified CPU demo',
    detail: 'The synthetic insole workflow completed on CPU with Python 3.12. The study workflow needs prepared insole or motion recordings, and the article checkpoints are separate from the release.',
    version: { label: `Release ${kinetics.version}`, href: kinetics.release },
    guide: { label: 'Run the workflow', href: sitePath(`research/${kinetics.slug}/#reproduce`) },
  },
  [ramanSource.slug]: {
    label: 'Source snapshot with synthetic demo',
    detail: 'The repository documents a Python 3.11–3.13 CPU notebook with synthetic data. Published-result reproduction remains unresolved and the study spectra require dataset access.',
    version: { label: `Source at ${ramanSource.revision.slice(0, 7)}`, href: ramanSource.source },
    guide: { label: 'Workflow notebook', href: ramanSource.notebook },
  },
  'kidney-stone-segmentation': {
    label: 'Study source snapshot',
    detail: 'The workflow expects prepared CT slices and stone masks. The public repository provides the study scripts and notebooks. Reproducing the reported Dice scores would require the study inputs and evaluation setup.',
    version: { label: 'Study source at 801800d', href: 'https://github.com/Sakib1263/Kidney-Stone-Segmentation/tree/801800d71af008d95a7b38143d00a92ebf7c9cec' },
    guide: { label: 'How to cite', href: 'https://github.com/Sakib1263/Kidney-Stone-Segmentation/blob/46f653d/CITATION.cff' },
  },
  'prenatal-hydronephrosis': {
    label: 'Study source snapshot',
    detail: 'The workflow uses prepared fetal kidney ultrasound views for region detection, segmentation, and severity grading. Full reproduction requires the study inputs and evaluation setup.',
    version: { label: 'Study source at 1a5e1de', href: 'https://github.com/Sakib1263/AHN-Severity-Stratification/tree/1a5e1de545961f0e3aef6d406622567fd8e88cd4' },
    guide: { label: 'How to cite', href: 'https://github.com/Sakib1263/AHN-Severity-Stratification/blob/f2fca50/CITATION.cff' },
  },
};

const software = [
  {
    slug: 'superonn-layers',
    title: 'SuperONN-Layers',
    area: 'Reusable library',
    summary: 'Polynomial 1D and 2D super-operational layers for PyTorch and TensorFlow/Keras, including forward and transposed operations with fixed or trainable offsets.',
    code: 'https://github.com/Sakib1263/SuperONN-Layers',
  },
  ...projects.map(({ title, area, summary, code, doi, slug }) => ({
    slug,
    title,
    area,
    summary,
    code,
    paper: sitePath(`publications/#${publicationId(doi)}`),
    project: sitePath(`research/${slug}/`),
  })),
];

const sections = [
  { id: 'datasets', label: 'Datasets', count: datasets.length },
  { id: 'code-title', label: 'Research software', count: software.length },
];
---

<Base title="Software & Data" description="Sakib Mahmud’s research software and dataset contributions, including Raman spectroscopy, chest radiographs, and hip implant imaging.">
  <div class="shell">
    <section class="page-intro catalog-intro">
      <div class="catalog-heading">
        <div>
          <h1>Software &amp; Data</h1>
          <p class="page-lead">Dataset records, research implementations, and reproducible workflows.</p>
        </div>
        <div class="actions">
          <SiteLink class="text-link" href={profile.github}>GitHub profile <span aria-hidden="true">↗</span></SiteLink>
        </div>
      </div>
    </section>

    <div class="catalog-layout content-end">
      <nav class="catalog-index software-index" aria-label="Software & Data sections">
        <h2>On this page</h2>
        <ul>
          {sections.map(({ id, label, count }) => (
            <li>
              <SiteLink href={`#${id}`}><span>{label}</span><span class="catalog-count" aria-hidden="true">{count}</span></SiteLink>
            </li>
          ))}
        </ul>
      </nav>

      <div class="software-catalog">
        <section aria-labelledby="datasets">
          <header class="catalog-section-heading">
            <h2 id="datasets">Datasets</h2>
            <p>What each release contains, how to access it, and my role in the study.</p>
          </header>
          {datasets.map(dataset => {
            const study = publicationFor(dataset.studyDoi);
            return (
              <article class="catalog-entry software-entry" id={dataset.id}>
                <div class="catalog-meta">
                  <span class="software-meta-title">{dataset.year}</span>
                  <span>{dataset.platform}</span>
                  <span>{dataset.access}</span>
                </div>
                <div>
                  <h3>{dataset.title}</h3>
                  <ul class="dataset-facts" aria-label="Dataset contents">
                    {dataset.facts.map(fact => <li>{fact}</li>)}
                  </ul>
                  <p class="software-summary">{dataset.summary}</p>
                  <dl class="dataset-usage">
                    <div><dt>License</dt><dd><SiteLink href={dataset.license.href}>{dataset.license.label}</SiteLink></dd></div>
                    <div><dt>Files</dt><dd>{dataset.files}</dd></div>
                    <div><dt>Evaluation</dt><dd>{dataset.evaluation.text} <SiteLink href={dataset.evaluation.href}>{dataset.evaluation.label}</SiteLink></dd></div>
                  </dl>
                  <p class="dataset-contribution"><strong>My contribution</strong> {dataset.contribution}</p>
                  {dataset.credit && <p class="dataset-credit">{dataset.credit}</p>}
                  <div class="catalog-actions">
                    <SiteLink href={doiUrl(dataset.doi)} aria-label={`${dataset.platform} record for ${dataset.title}`}>{dataset.platform} record <span aria-hidden="true">↗</span></SiteLink>
                    <SiteLink href={sitePath(`publications/#${publicationId(study.doi)}`)} aria-label={`Related paper for ${dataset.title}`} title={study.title}>Related paper</SiteLink>
                  </div>
                </div>
              </article>
            );
          })}
        </section>

        <section aria-labelledby="code-title">
          <header class="catalog-section-heading">
            <h2 id="code-title">Research software</h2>
            <p>Reusable layers and implementations accompanying my papers.</p>
          </header>
          {software.map(item => {
            const notes = softwareNotes[item.slug];
            return (
              <article class="catalog-entry software-entry">
                <div class="catalog-meta"><span>{item.area}</span>{notes && <strong>{notes.label}</strong>}</div>
                <div>
                  <h3>{item.title}</h3>
                  <p class="software-summary">{item.summary}</p>
                  {notes && <p class="dataset-credit">{notes.detail}</p>}
                  <div class="catalog-actions">
                    {notes && <SiteLink href={notes.version.href}>{notes.version.label} <span aria-hidden="true">↗</span></SiteLink>}
                    {notes?.guide && <SiteLink href={notes.guide.href}>{notes.guide.label}</SiteLink>}
                    {item.slug === kinetics.slug && <SiteLink href={sitePath(kinetics.verificationPath)}>Demo verification</SiteLink>}
                    <SiteLink href={item.code} aria-label={`GitHub repository for ${item.title}`}>GitHub repository <span aria-hidden="true">↗</span></SiteLink>
                    {'project' in item && <SiteLink href={item.project}>Project summary</SiteLink>}
                    {'paper' in item && <SiteLink href={item.paper} aria-label={`Related paper for ${item.title}`}>Related paper</SiteLink>}
                  </div>
                </div>
              </article>
            );
          })}
        </section>
      </div>
    </div>
  </div>
</Base>
