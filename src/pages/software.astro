---
import Base from '../layouts/Base.astro';
import { projects, type Project } from '../data/research';
import { doiUrl, profile } from '../lib/site';

const software: { name: string; description: string; url?: string; project?: Project }[] = [
  { name: 'SuperONN-Layers', description: 'Reusable super-operational layers for PyTorch and TensorFlow/Keras.', url: 'https://github.com/Sakib1263/SuperONN-Layers' },
  { name: 'Unimodal 3D kinetics estimation', description: 'Research repository for estimating foot kinetics from wearable measurements.', project: projects[0] },
  { name: 'Kidney Stone Segmentation', description: 'Code for successive scope reduction and segmentation in abdominal CT.', project: projects[1] },
  { name: 'SERS-D2DNet and SuperRaman', description: 'Code for cross-device Raman spectrum standardization and bacterial recognition experiments.', project: projects[2] },
  { name: 'NABNet', description: 'Implementation for arterial blood pressure waveform reconstruction and component estimation.', project: projects[3] },
  { name: 'AHN Severity Stratification', description: 'Ultrasound workflow for region detection, kidney segmentation, and severity classification.', url: 'https://github.com/Sakib1263/AHN-Severity-Stratification' },
];
---

<Base title="Software & Data" description="Public research code and dataset records maintained or co-authored by Sakib Mahmud.">
  <section class="shell page-intro">
    <h1>Software &amp; Data</h1>
    <p class="page-lead">Research implementations, reusable libraries, and dataset records.</p>
    <a class="text-link" href={profile.github}>GitHub profile <span aria-hidden="true">↗</span></a>
  </section>
  <section class="shell content-end" aria-labelledby="code-title">
    <h2 class="section-title" id="code-title">Research software</h2>
    <div class="resource-list">
      {software.map(item => (
        <article class="resource-row">
          <div>
            <h3>{item.name}</h3>
            <p>{item.description}</p>
          </div>
          <div class="resource-links">
            <a class="text-link" href={item.project?.code ?? item.url} aria-label={`Code for ${item.name}`}>Code <span aria-hidden="true">↗</span></a>
            {item.project && <a class="text-link secondary-link" href={doiUrl(item.project.doi)} aria-label={`Paper for ${item.name}`}>Paper <span aria-hidden="true">↗</span></a>}
          </div>
        </article>
      ))}
    </div>
    <h2 class="section-title data-heading">Dataset record</h2>
    <div class="resource-list">
      <article class="resource-row">
        <div>
          <h3>Multi-Instrument SERS Dataset</h3>
          <p>Raman spectra from five instruments. Zenodo provides the public metadata and instructions for requesting access to the restricted data files.</p>
        </div>
        <a class="text-link" href="https://zenodo.org/records/23372983">Zenodo record <span aria-hidden="true">↗</span></a>
      </article>
    </div>
  </section>
</Base>
