---
import SiteLink from '../../components/SiteLink.astro';
import ResearchSnapshot from '../../components/ResearchSnapshot.astro';
import Base from '../../layouts/Base.astro';
import { datasetsByStudy } from '../../data/datasets';
import { publicationFor, publicationId } from '../../data/papers';
import { caseStudyProjects } from '../../data/research';
import { researchGroups, researchProjects } from '../../data/research-catalog';
import { sitePath } from '../../lib/site';
import '../../styles/catalog.css';
import '../../styles/research.css';
---

<Base title="Research" description="Sakib Mahmud’s research projects in wearable biomechanics, medical imaging, physiological signals, Raman spectroscopy, biomedical devices, genomics, and applied machine learning.">
  <div class="shell">
    <section class="page-intro catalog-intro">
      <h1>Research</h1>
      <p class="page-lead">I develop methods to recover biomedical measurements from images and sensor signals. My work examines how well those methods transfer across people, instruments, and datasets.</p>
      <p class="research-intro-detail">{researchProjects.length} projects across {researchGroups.length} research areas</p>
      <nav class="quick-study-links" aria-label="Featured research shortcuts">
        {caseStudyProjects.map(({ slug, evidence, title }) => <SiteLink href={sitePath(`research/${slug}/`)}>{evidence?.label ?? title}</SiteLink>)}
        <SiteLink href="#project-catalog">Jump to projects <span aria-hidden="true">↓</span></SiteLink>
      </nav>
    </section>

    <ResearchSnapshot />

    <p class="research-direction">I’m now testing <SiteLink href={sitePath('research/multimodal-wearable-kinetics/')}>gait models that combine pressure and motion</SiteLink> and studying <SiteLink href={sitePath('research/multiphase-liver-ct/')}>how CT contrast phases affect liver and tumour segmentation</SiteLink>. Both projects ask how well a model transfers when the people, data, or acquisition conditions change.</p>

    <div class="catalog-layout content-end" id="project-catalog">
      <nav class="catalog-index research-index" aria-label="Research areas">
        <h2>Research areas</h2>
        <ul>
          {researchGroups.map(({ id, title, projects }) => (
            <li>
              <SiteLink href={`#${id}`}><span>{title}</span><span class="catalog-count" aria-hidden="true">{projects.length}</span></SiteLink>
            </li>
          ))}
        </ul>
      </nav>

      <div class="research-catalog">
        {researchGroups.map(({ id, title, description, projects }) => (
          <section class="research-group" aria-labelledby={id}>
            <header class="catalog-section-heading">
              <h2 id={id}>{title}</h2>
              <p>{description}</p>
            </header>
            {projects.map(project => {
              const paper = project.doi && publicationFor(project.doi);
              const dataset = project.doi && datasetsByStudy.get(project.doi);
              const period = project.period || (paper && `${paper.year}${paper.onlineYear ? ` · Online ${paper.onlineYear}` : ''}`);
              return (
                <article class="catalog-entry research-entry" id={project.slug}>
                  <div class="catalog-meta">
                    {period && <span class="research-period">{period}</span>}
                    {project.status && <span class="research-status">{project.status}</span>}
                    {!project.status && paper && <span>{paper.type}</span>}
                  </div>
                  <div>
                    <h3><SiteLink href={sitePath(`research/${project.slug}/`)}>{project.title}</SiteLink></h3>
                    <p class="research-summary">{project.summary}</p>
                    {(paper || project.code || dataset) && <div class="catalog-actions">
                      {paper && <SiteLink aria-label={`Publication for ${project.title}`} href={sitePath(`publications/#${publicationId(paper.doi)}`)}>Publication</SiteLink>}
                      {project.code && <SiteLink aria-label={`Code for ${project.title}`} href={project.code}>Code <span aria-hidden="true">↗</span></SiteLink>}
                      {dataset && <SiteLink aria-label={`Dataset for ${project.title}`} href={sitePath(`software/#${dataset.id}`)}>Dataset</SiteLink>}
                    </div>}
                  </div>
                </article>
              );
            })}
          </section>
        ))}
      </div>
    </div>
  </div>
</Base>
