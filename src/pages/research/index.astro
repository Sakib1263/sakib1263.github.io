---
import SiteLink from '../../components/SiteLink.astro';
import ResearchSnapshot from '../../components/ResearchSnapshot.astro';
import Base from '../../layouts/Base.astro';
import { miscellaneousStudies, periodYears, projectAreas } from '../../data/research-projects';
import { sitePath } from '../../lib/site';
import '../../styles/catalog.css';
import '../../styles/research.css';

const projectCount = projectAreas.reduce((total, area) => total + area.entries.length, 0) + miscellaneousStudies.length;
const miscellaneousSearchText = (study: (typeof miscellaneousStudies)[number]) =>
  [study.title, study.summary, study.question, study.approach, study.scope, study.doi, ...(study.papers ?? [])].filter(Boolean).join(' ');
---

<Base title="Research" description="Sakib Mahmud’s research projects in wearable biomechanics, medical imaging, physiological signals, Raman spectroscopy, biomedical devices, genomics, and applied machine learning.">
  <div class="shell">
    <section class="page-intro catalog-intro">
      <h1>Research</h1>
      <p class="page-lead">I develop methods to recover biomedical measurements from images and sensor signals. My work examines how well those methods transfer across people, instruments, and datasets.</p>
    </section>

    <ResearchSnapshot />

    <div id="project-catalog">
      <h2 class="research-catalog-title">Selected projects and research lines</h2>
      <p class="research-intro-detail">Explore the projects, my role, and the studies, datasets, and software that came out of them.</p>
      <form class="research-search" aria-label="Filter research projects" data-research-search hidden>
        <div class="research-search-controls">
          <label>Search projects
            <input type="search" name="query" placeholder="Project, method, or modality" autocomplete="off" />
          </label>
          <button class="button button-secondary" type="reset" hidden>Clear search</button>
        </div>
        <p class="research-search-count" role="status" data-research-count>{projectCount} entries</p>
      </form>
    </div>
    <div class="catalog-layout content-end" data-research-catalog>
      <nav class="catalog-index research-index" aria-label="Research areas" data-research-areas>
        <h2>Research areas</h2>
        <ul>
          {projectAreas.map(({ id, title, entries }) => (
            <li data-research-area={id}>
              <SiteLink href={`#${id}`}><span>{title}</span><span class="catalog-count" aria-hidden="true" data-area-count>{entries.length}</span></SiteLink>
            </li>
          ))}
          {miscellaneousStudies.length > 0 && (
            <li data-research-area="miscellaneous">
              <SiteLink href="#miscellaneous"><span>Miscellaneous studies</span><span class="catalog-count" aria-hidden="true" data-area-count>{miscellaneousStudies.length}</span></SiteLink>
            </li>
          )}
        </ul>
      </nav>

      <div class="research-catalog">
        <p class="empty-state" data-research-empty hidden>Try a different project name, method, or modality.</p>
        {projectAreas.map(({ id, title, description, entries }) => (
          <section class="research-group" aria-labelledby={id} data-research-group={id}>
            <header class="catalog-section-heading">
              <h2 id={id}>{title}</h2>
              <p>{description}</p>
            </header>
            {entries.map(entry => (
              <article class="catalog-entry research-entry" id={entry.slug} data-research-project-row data-methods={entry.searchText}>
                <div class="catalog-meta">
                  {entry.aliases.map(slug => <span id={slug} class="research-anchor" aria-hidden="true"></span>)}
                  {entry.period && <span class="research-period">{periodYears(entry.period)}</span>}
                </div>
                <div>
                  <h3><SiteLink href={sitePath(entry.path)}>{entry.title}</SiteLink></h3>
                  {entry.context && <p class="research-entry-context">{entry.context}</p>}
                  <p class="research-summary">{entry.summary}</p>
                </div>
              </article>
            ))}
          </section>
        ))}
        {miscellaneousStudies.length > 0 && (
          <section class="research-group research-archive" aria-labelledby="miscellaneous" data-research-group="miscellaneous">
            <header class="catalog-section-heading">
              <h2 id="miscellaneous">Miscellaneous studies</h2>
            </header>
            <ul>
              {miscellaneousStudies.map(study => (
                <li id={study.slug} data-research-project-row data-methods={miscellaneousSearchText(study)}><SiteLink href={sitePath(`research/${study.slug}/`)}>{study.title}</SiteLink></li>
              ))}
            </ul>
          </section>
        )}
      </div>
    </div>
  </div>
</Base>

<script>
  import '../../scripts/research-search';
</script>
