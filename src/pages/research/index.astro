---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { featuredProjects, projects } from '../../data/research';
import { sitePath } from '../../lib/site';

const additional = projects.filter(project => !project.visual);
---

<Base title="Research" description="Selected research by Sakib Mahmud in wearable biomechanics, medical imaging, spectroscopy, and physiological signal processing.">
  <section class="shell page-intro">
    <h1>Research</h1>
    <p class="page-lead">Machine learning for biomedical images, wearable measurements, physiological signals, and spectra.</p>
  </section>
  <section class="shell content-end" aria-label="Research projects">
    <div class="project-grid">
      {featuredProjects.map(project => <ProjectCard project={project} />)}
    </div>
    <div class="resource-list research-more">
      {additional.map(project => (
        <article class="resource-row">
          <div>
            <p class="overline">{project.area}</p>
            <h2>{project.title}</h2>
            <p>{project.summary}</p>
          </div>
          <a class="text-link" href={sitePath(`research/${project.slug}/`)} aria-label={`View project: ${project.title}`}>View project <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>
</Base>
