---
import SiteLink from '../../components/SiteLink.astro';
import { Image, getImage } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import KineticsReproduction from '../../components/KineticsReproduction.astro';
import HydronephrosisExample from '../../components/HydronephrosisExample.astro';
import { datasetsByStudy } from '../../data/datasets';
import { kinetics } from '../../data/kinetics';
import { ramanSource } from '../../data/raman';
import { openFullText, publicationFor, publicationId } from '../../data/papers';
import { researchProjectFor, researchProjects } from '../../data/research-catalog';
import type { ResearchProject } from '../../data/research';
import { doiUrl, sitePath } from '../../lib/site';
import '../../styles/catalog.css';
import '../../styles/research.css';

export function getStaticPaths() {
  return researchProjects.map(project => ({ params: { slug: project.slug }, props: { project } }));
}

interface Props { project: ResearchProject }

const { project } = Astro.props;
const { visual, resultVisual } = project;
const resultView = resultVisual && await getImage({ src: resultVisual.image, format: 'webp', width: 960 });
const paper = project.doi ? publicationFor(project.doi) : undefined;
const dataset = project.doi ? datasetsByStudy.get(project.doi) : undefined;
const fullText = project.doi ? openFullText[project.doi] : undefined;
const relatedPapers = (project.related ?? []).map(publicationFor);
const relatedProjects = (project.relatedProjects ?? []).map(researchProjectFor);
const imageWidth = visual ? Math.min(visual.image.width, 960) : 0;
const workflowAvailable = project.slug === kinetics.slug;
const isRamanCase = project.slug === ramanSource.slug;
const hasResults = Boolean(project.result || project.measures?.length);
const sections = [
  { id: 'approach', label: 'Approach' },
  ...(hasResults ? [{ id: 'results', label: 'Reported results' }] : []),
  { id: 'contribution', label: 'My contribution' },
  ...(project.scope ? [{ id: 'scope', label: 'Study scope' }] : []),
  ...(project.ongoing ? [{ id: 'ongoing', label: 'Ongoing work' }] : []),
  ...(workflowAvailable ? [{ id: 'reproduce', label: 'Run the workflow' }] : []),
  ...(relatedPapers.length ? [{ id: 'related-title', label: 'Related publications' }] : []),
  ...(relatedProjects.length ? [{ id: 'related-projects', label: 'Related projects' }] : []),
];
---

<Base title={project.title} description={project.summary} shareImage={project.evidence?.shareImage ?? visual?.image} largeShareImage={Boolean(project.evidence)}>
  <article class="shell">
    <header class="page-intro catalog-intro research-project-intro">
      <SiteLink class="text-link return-link" href={sitePath(`research/#${project.slug}`)}><span aria-hidden="true">←</span> All research</SiteLink>
      <p class="overline">{project.area}{project.status && ` · ${project.status}`}</p>
      <h1>{project.title}</h1>
      <p class="page-lead">{project.question ?? project.summary}</p>
      {project.evidence && <dl class="research-evidence">
        <div><dt>What I led</dt><dd>{project.evidence.role}</dd></div>
        <div><dt>What the study found</dt><dd>{project.evidence.finding}</dd></div>
      </dl>}
      {[project.context, project.period].some(Boolean) && <p class="research-intro-detail">{[project.context, project.period].filter(Boolean).join(' · ')}</p>}
      {paper && <p class="study-citation">{paper.venue} · {paper.year}{paper.onlineYear && ` (online ${paper.onlineYear})`}</p>}
      {(paper || project.code || project.resources?.length) && <div class="actions">
        {paper && <SiteLink class="button button-primary" href={doiUrl(paper.doi)}>Read the paper <span aria-hidden="true">↗</span></SiteLink>}
        {fullText && <SiteLink class="text-link" href={fullText}>Open full text <span aria-hidden="true">↗</span></SiteLink>}
        {project.code && <SiteLink class="button button-secondary" href={isRamanCase ? ramanSource.source : project.code}>{isRamanCase ? 'Recovered source code' : 'Source code'} <span aria-hidden="true">↗</span></SiteLink>}
        {project.resources?.map(({ label, href }) => <SiteLink class="text-link" href={href}>{label} <span aria-hidden="true">↗</span></SiteLink>)}
        {dataset && <>
          <SiteLink class="text-link" href={sitePath(`software/#${dataset.id}`)}>Dataset details</SiteLink>
          <SiteLink class="text-link" href={doiUrl(dataset.doi)}>{dataset.platform} record <span aria-hidden="true">↗</span></SiteLink>
        </>}
        {workflowAvailable && <SiteLink class="text-link" href="#reproduce">Run the workflow</SiteLink>}
        {paper && <SiteLink class="text-link" data-project-citation href={sitePath(`publications/#${publicationId(paper.doi)}`)}>Citation</SiteLink>}
      </div>}
      {isRamanCase && <section class="research-code-note" aria-labelledby="raman-code-title">
        <h2 id="raman-code-title">Code and reproduction</h2>
        <p>The recovered translator has 61.5 million parameters. The paper reports 6.15 million. The synthetic CPU demo exercises four small translators and a classifier. Reproducing the reported results requires matching the published architecture and evaluation protocol. Paper-trained weights are unavailable.</p>
        <div class="catalog-actions">
          <SiteLink href={ramanSource.notebook}>Synthetic demo notebook <span aria-hidden="true">↗</span></SiteLink>
          <SiteLink href={ramanSource.alignment}>Paper and code comparison <span aria-hidden="true">↗</span></SiteLink>
        </div>
      </section>}
    </header>

    <div class="catalog-layout content-end">
      <nav class="catalog-index research-index" aria-label="Project sections">
        <h2>On this page</h2>
        <ul>{sections.map(({ id, label }) => <li><SiteLink href={`#${id}`}><span>{label}</span></SiteLink></li>)}</ul>
      </nav>

      <div class="research-detail">
        <section aria-labelledby="approach">
          <header class="catalog-section-heading"><h2 id="approach">Approach</h2></header>
          <p class="research-section-copy">{project.approach}</p>
          {project.workflow && <ol class="study-workflow" aria-label="Study workflow">
            {project.workflow.map(step => <li>{step}</li>)}
          </ol>}
          {visual && (
            <figure class:list={['detail-figure', `art-${project.slug}`]}>
              <div class:list={{ 'waveform-plot': visual.chart }}>
                {visual.chart && <div class="chart-heading"><h3>{visual.chart.title}</h3><p>{visual.chart.verticalAxis}</p></div>}
                <Image src={visual.image} alt={visual.alt} width={imageWidth} widths={[320, 480, 640, 768, 960].filter(width => width < imageWidth).concat(imageWidth)} sizes="(max-width: 850px) calc(100vw - 4rem), 700px" format="webp" />
                {visual.chart && <p>{visual.chart.horizontalAxis}</p>}
              </div>
              <figcaption>
                {visual.caption}
                <span class="figure-links">
                  <SiteLink href={visual.image.src}>View full-size figure</SiteLink>
                  {visual.credit && <SiteLink href={visual.credit.href}>{visual.credit.label}</SiteLink>}
                </span>
              </figcaption>
            </figure>
          )}
          {project.illustratedExample && <HydronephrosisExample />}
        </section>

        {hasResults && <section aria-labelledby="results">
          <header class="catalog-section-heading"><h2 id="results">Reported results</h2></header>
          {project.result && <p class="research-section-copy">{project.result}</p>}
          {project.measures?.length && <dl class="study-measures">
            {project.measures.map(({ value, label }) => <div><dt>{label}</dt><dd>{value}</dd></div>)}
          </dl>}
          {resultVisual && resultView && <figure class="detail-figure">
            <div class="waveform-plot result-figure">
              <img class:list={{ 'result-overview': resultVisual.mobileColumns }} src={resultView.src} {...resultView.attributes} alt={resultVisual.alt} loading="lazy" decoding="async" />
              {resultVisual.mobileColumns && <div class="result-panels" role="group" aria-label={resultVisual.alt}>
                {resultVisual.mobileColumns.map(label => (
                  <div role="img" aria-label={label}><img src={resultView.src} {...resultView.attributes} alt="" loading="lazy" decoding="async" /></div>
                ))}
              </div>}
            </div>
            <figcaption>
              {resultVisual.caption}
              <span class="figure-links">
                <SiteLink href={resultVisual.image.src}>View full-size figure</SiteLink>
                <SiteLink href={resultVisual.source.href}>{resultVisual.source.label}</SiteLink>
              </span>
            </figcaption>
          </figure>}
        </section>}

        <section aria-labelledby="contribution">
          <header class="catalog-section-heading"><h2 id="contribution">My contribution</h2></header>
          <p class="research-section-copy">{project.contribution}</p>
        </section>
        {project.scope && <section aria-labelledby="scope">
          <header class="catalog-section-heading"><h2 id="scope">Study scope</h2></header>
          <p class="research-section-copy">{project.scope}</p>
        </section>}
        {project.ongoing && <section aria-labelledby="ongoing">
          <header class="catalog-section-heading"><h2 id="ongoing">Ongoing work</h2></header>
          <p class="research-section-copy">{project.ongoing}</p>
        </section>}
        {workflowAvailable && <KineticsReproduction />}

        {relatedPapers.length > 0 && <section class="related-papers" aria-labelledby="related-title">
          <header class="catalog-section-heading"><h2 id="related-title">Related publications</h2></header>
          <ul>
            {relatedPapers.map(publication => (
              <li><SiteLink href={sitePath(`publications/#${publicationId(publication.doi)}`)}>{publication.title}</SiteLink><small>{publication.venue} · {publication.year}</small></li>
            ))}
          </ul>
        </section>}
        {relatedProjects.length > 0 && <section class="related-papers" aria-labelledby="related-projects">
          <header class="catalog-section-heading"><h2 id="related-projects">Related projects</h2></header>
          <ul>
            {relatedProjects.map(related => <li><SiteLink href={sitePath(`research/${related.slug}/`)}>{related.title}</SiteLink></li>)}
          </ul>
        </section>}
      </div>
    </div>
  </article>
</Base>
