---
import Base from '../layouts/Base.astro';
import {
  citationText, citedPaperNotes, displayAuthor, openFullText, paperResources,
  publicationId, publications, publicationDetails, selectedPapers, topicDescriptions, topics,
} from '../data/papers';
import { projects } from '../data/research';
import { doiUrl, profile, researchProfiles, sitePath } from '../lib/site';
import '../styles/publications.css';

const years = [...new Set(publications.map(({ year }) => year))];
const types = [...new Set(publications.map(({ type }) => type))].sort();
const topicList = Object.keys(topics) as (keyof typeof topics)[];
const clusters = topicList.map(topic => ({
  topic,
  title: topics[topic],
  description: topicDescriptions[topic],
  papers: publications.filter(paper => paper.topic === topic),
}));
const projectsByDoi = new Map(projects.map(project => [project.doi, project]));
const selectedDois = new Set(selectedPapers.map(({ publication }) => publication.doi));
---

<Base title="Publications" description="Browse Sakib Mahmud’s publications by research area, with study summaries, personal contributions, citations, and links to papers and research resources.">
  <div class="shell">
    <section class="page-intro publications-intro">
      <div class="publications-heading">
        <div>
          <h1>Publications</h1>
          <p class="page-lead">Study summaries and my contributions across six research areas.</p>
        </div>
        <div class="actions">
          <a class="button button-primary" href={sitePath('publications/?view=selected#bibliography')}>{selectedDois.size} selected papers</a>
          <a class="text-link" href={sitePath('publications.bib')} download>Download BibTeX <span aria-hidden="true">↓</span></a>
        </div>
      </div>
      <nav class="publication-profiles" aria-labelledby="research-profiles">
        <h2 id="research-profiles">Research profiles</h2>
        <ul>
          {researchProfiles.map(({ label, href }) => (
            <li><a href={href}>{label}</a></li>
          ))}
        </ul>
      </nav>
    </section>

    <div class="bibliography-layout content-end">
      <nav class="publication-clusters" aria-label="Publication research areas">
        <h2>Research areas</h2>
        <ul>
          {clusters.map(({ topic, title, papers }) => (
            <li>
              <a data-topic-link={topic} href={sitePath(`publications/?topic=${topic}#cluster-${topic}`)}>
                <span>{title}</span><span class="topic-count" aria-label={`${papers.length} publications`}>{papers.length}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <section class="bibliography" aria-labelledby="bibliography">
        <header class="bibliography-heading">
          <h2 id="bibliography">Publication list</h2>
          <p>The selected papers include recent work and widely cited studies.</p>
        </header>
        <form class="publication-filters" aria-label="Filter publications" data-publication-filters hidden>
          <label class="search-field">Search
            <input type="search" name="query" placeholder="Title, author, method, or DOI" autocomplete="off" />
          </label>
          <label class="selection-filter"><input type="checkbox" name="view" value="selected" /> Selected papers only</label>
          <label>Topic
            <select name="topic">
              <option value="">All topics</option>
              {clusters.map(({ topic, title }) => <option value={topic}>{title}</option>)}
            </select>
          </label>
          <label>Issue year
            <select name="year">
              <option value="">All years</option>
              {years.map(year => <option value={year}>{year}</option>)}
            </select>
          </label>
          <label>Type
            <select name="type">
              <option value="">All types</option>
              {types.map(type => <option value={type}>{type}</option>)}
            </select>
          </label>
          <button class="button button-secondary reset-filters" type="reset">Clear filters</button>
        </form>
        <div class="publication-list-info">
          <p class="result-count" data-publication-count role="status">{publications.length} publications</p>
          <p class="selection-note">Citation counts from <a href="https://openalex.org/">OpenAlex</a>, 16 Nov 2026</p>
        </div>
        <p class="empty-state" data-publication-empty hidden>Try a different search or clear the filters.</p>
        <div class="publication-list">
          {clusters.map(cluster => (
            <section class="publication-group" data-publication-group aria-labelledby={`cluster-${cluster.topic}`}>
              <header class="publication-group-heading" id={`cluster-${cluster.topic}`}>
                <h3>{cluster.title}</h3>
                <p>{cluster.description}</p>
              </header>
              {cluster.papers.map(publication => {
                const id = publicationId(publication.doi);
                const project = projectsByDoi.get(publication.doi);
                const { summary, contribution } = publicationDetails(publication.doi);
                const citations = citedPaperNotes[publication.doi];
                const selected = selectedDois.has(publication.doi);
                const firstAuthor = displayAuthor(publication.authors[0]).toLowerCase() === profile.name.toLowerCase();
                return (
                  <article id={id} class="publication" data-publication data-year={publication.year} data-type={publication.type} data-topic={publication.topic} data-selected={selected}>
                    <div class="publication-meta">
                      <p class="publication-year">{publication.year}{publication.onlineYear && <small>Online {publication.onlineYear}</small>}</p>
                      <span>{publication.type}</span>
                      {firstAuthor && <span class="publication-first-author">First author</span>}
                      {citations && <span>{citations} citations</span>}
                    </div>
                    <div class="publication-main">
                      <h4><a data-paper-title href={doiUrl(publication.doi)}>{publication.title}</a></h4>
                      <p class="publication-authors">
                        {publication.authors.map((author, index) => {
                          const name = displayAuthor(author);
                          return <>{name.toLowerCase() === profile.name.toLowerCase() ? <strong>{name}</strong> : name}{index < publication.authors.length - 1 ? ', ' : ''}</>;
                        })}
                      </p>
                      <p class="publication-venue">
                        <cite>{publication.venue}</cite>
                        {publication.volume && ` · ${publication.volume}${publication.issue ? `(${publication.issue})` : ''}`}
                        {publication.articleNumber ? ` · Article ${publication.articleNumber}` : publication.pages && ` · ${publication.pages}`}
                      </p>
                      <p class="publication-summary">{summary}</p>
                      <details class="publication-details">
                        <summary>My contribution</summary>
                        <p class="publication-contribution">{contribution}</p>
                      </details>
                      <div class="publication-actions">
                        {project && <><a href={sitePath(`research/${project.slug}/`)}>Project summary</a><a href={project.code}>Code <span aria-hidden="true">↗</span></a></>}
                        {openFullText[publication.doi] && <a href={openFullText[publication.doi]}>Open full text <span aria-hidden="true">↗</span></a>}
                        {paperResources[publication.doi]?.map(({ label, href }) => <a href={href}>{label} <span aria-hidden="true">↗</span></a>)}
                        <a href={`#${id}`} aria-label={`Permalink to ${publication.title}`}>Permalink</a>
                        <button type="button" data-citation={citationText(publication)} aria-label={`Copy citation for ${publication.title}`} hidden>Copy citation</button>
                      </div>
                      <label class="citation-fallback" hidden>Copy this citation
                        <textarea rows="3" readonly></textarea>
                      </label>
                      <p class="citation-status" role="status"></p>
                    </div>
                  </article>
                );
              })}
            </section>
          ))}
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import '../scripts/publications';
</script>
