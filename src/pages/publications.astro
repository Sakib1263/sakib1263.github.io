---
import Base from '../layouts/Base.astro';
import { displayAuthor, publications, topics } from '../data/papers';
import { doiUrl, profile, sitePath } from '../lib/site';

const years = [...new Set(publications.map(({ year }) => year))];
const types = [...new Set(publications.map(({ type }) => type))].sort();
const topicList = Object.entries(topics);
---

<Base title="Publications" description="Browse Sakib Mahmud’s research publications by topic, issue year, or publication type.">
  <section class="shell page-intro">
    <h1>Publications</h1>
    <p class="page-lead">Browse my papers by topic or search by title, author, venue, or DOI.</p>
    <div class="actions">
      <a class="text-link" href={profile.scholar}>Google Scholar <span aria-hidden="true">↗</span></a>
      <a class="text-link" href={sitePath('publications.bib')} download>Download BibTeX <span aria-hidden="true">↓</span></a>
    </div>
  </section>
  <section class="shell content-end" aria-label="Publication list">
    <form class="publication-filters" aria-label="Filter publications" data-publication-filters hidden>
      <label class="search-field">Search
        <input type="search" name="query" placeholder="Title, author, venue, or DOI" autocomplete="off" />
      </label>
      <label>Topic
        <select name="topic">
          <option value="">All topics</option>
          {topicList.map(([key, label]) => <option value={key}>{label}</option>)}
        </select>
      </label>
      <label>Issue year
        <select name="year">
          <option value="">All years</option>
          {years.map(year => <option value={year}>{year}</option>)}
        </select>
      </label>
      <label>Type
        <select name="type">
          <option value="">All types</option>
          {types.map(type => <option value={type}>{type}</option>)}
        </select>
      </label>
      <button class="button button-secondary reset-filters" type="reset">Clear filters</button>
    </form>
    <p class="result-count" data-publication-count role="status">{publications.length} publications</p>
    <p class="empty-state" data-publication-empty hidden>Try a different search or clear the filters.</p>
    <div class="publication-list">
      {publications.map(publication => (
        <article class="publication" data-publication data-year={publication.year} data-type={publication.type} data-topic={publication.topic}>
          <p class="publication-year">{publication.year}{publication.onlineYear && <small>Online {publication.onlineYear}</small>}</p>
          <div>
            <h2><a href={doiUrl(publication.doi)}>{publication.title}</a></h2>
            <p class="publication-authors">
              {publication.authors.map((author, index) => {
                const name = displayAuthor(author);
                return <>{name.toLowerCase() === profile.name.toLowerCase() ? <strong>{name}</strong> : name}{index < publication.authors.length - 1 ? ', ' : ''}</>;
              })}
            </p>
            <p class="publication-venue">
              {publication.venue}
              {publication.volume && ` · ${publication.volume}${publication.issue ? `(${publication.issue})` : ''}`}
              {publication.articleNumber ? ` · Article ${publication.articleNumber}` : publication.pages && ` · ${publication.pages}`}
              {' · '}{publication.type}
            </p>
          </div>
          <p class="publication-topic">{topics[publication.topic as keyof typeof topics]}</p>
        </article>
      ))}
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-publication-filters]');
  const count = document.querySelector<HTMLElement>('[data-publication-count]');
  const empty = document.querySelector<HTMLElement>('[data-publication-empty]');
  if (form && count && empty) {
    const normalize = (value: string) =>
      value.normalize('NFKD').replace(/\p{Diacritic}/gu, '').toLowerCase();
    const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-publication]')).map(row => ({
      row,
      text: normalize(row.textContent ?? '') + ' ' + normalize(row.querySelector('h2 a')?.getAttribute('href') ?? ''),
    }));

    function update() {
      const inputs = new FormData(form!);
      const words = normalize(String(inputs.get('query') ?? '')).trim().split(/\s+/).filter(Boolean);
      const year = String(inputs.get('year') ?? '');
      const type = String(inputs.get('type') ?? '');
      const topic = String(inputs.get('topic') ?? '');
      let matched = 0;
      for (const { row, text } of rows) {
        const show = (!year || row.dataset.year === year)
          && (!type || row.dataset.type === type)
          && (!topic || row.dataset.topic === topic)
          && words.every(word => text.includes(word));
        row.hidden = !show;
        if (show) matched += 1;
      }
      count!.textContent = matched === rows.length
        ? `${matched} publications`
        : `${matched} of ${rows.length} publications`;
      empty!.hidden = matched > 0;
    }

    form.hidden = false;
    form.addEventListener('input', update);
    form.addEventListener('submit', event => event.preventDefault());
    form.addEventListener('reset', () => requestAnimationFrame(update));
    update();
  }
</script>
