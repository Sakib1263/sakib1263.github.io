---
import SiteLink from '../components/SiteLink.astro';
import Base from '../layouts/Base.astro';
import { sitePath } from '../lib/site';
---

<Base title="Page not found" noIndex>
  <section class="shell page-intro content-end">
    <h1>Page not found</h1>
    <SiteLink class="text-link" href={sitePath()}><span aria-hidden="true">←</span> Return home</SiteLink>
  </section>
</Base>
